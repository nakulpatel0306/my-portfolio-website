{
  // Cloudflare Workers, serving dist/ as static assets. There is no Worker
  // script: the site is hand-written HTML, CSS and JS, so "main" is
  // deliberately absent and Cloudflare serves the files directly.
  //
  // dist/ is produced by `npm run build`, which copies the five things the
  // site needs. Pointing this at the repo root instead would upload .git,
  // the workflow and the README along with it.
  //
  // In the Cloudflare dashboard:
  //   Build command:  npm run build
  //   Deploy command: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio-part-two",
  "compatibility_date": "2026-09-26",
  // The custom domains, created on deploy along with their DNS records,
  // because the zone lives in the same Cloudflare account. Both are listed
  // so the apex and the www host each serve the site rather than one of
  // them dead-ending.
  "routes": [
    { "pattern": "nakul-patel.dev", "custom_domain": true },
    { "pattern": "www.nakul-patel.dev", "custom_domain": true }
  ],

  // workers.dev stays on as a fallback URL while the domain settles. Set it
  // to false once nakul-patel.dev serves the site, so there is one address
  // for it rather than two.
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    // an unknown path serves 404.html with a real 404 status, rather than
    // silently handing back the home page
    "not_found_handling": "404-page"
  }
}
